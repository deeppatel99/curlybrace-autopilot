# Copy this file to .env and fill in. NEVER commit .env.

# Writing — you need ONE of these, depending on writer.backend in config.yaml:
#  backend: claude-code (default) -> nothing needed on your PC, just log in to `claude` once.
#                                    For GitHub Actions only: run `claude setup-token` and put it
#                                    in a GitHub secret named CLAUDE_CODE_OAUTH_TOKEN.
#  backend: api                   -> console.anthropic.com API key (billed separately from Pro)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Required for image hosting — GitHub fine-grained token with
# "Contents: Read and write" on the curlybrace-autopilot repo only.
# (Inside GitHub Actions this is automatic; you don't need it there.)
GH_PAT=

# Optional — Medium Settings -> Security and apps -> Integration tokens.
# Only needed for publish.mode: api
MEDIUM_TOKEN=

# Optional — get a ping on Telegram when a draft is ready
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
